{
  "name": "atheneum",
  "productName": "Atheneum",
  "version": "0.1.0",
  "private": true,
  "description": "A personal catalogue for everything you consume.",
  "author": "Nane",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev": "concurrently -k -n vite,electron -c cyan,yellow \"vite\" \"wait-on tcp:5273 && electron .\"",
    "build:web": "tsc --noEmit && vite build",
    "build:win": "npm run build:web && electron-builder --win",
    "build:mac": "npm run build:web && electron-builder --mac",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:sync && npm run test:fill && npm run test:migrate && npm run test:app",
    "test:sync": "node scripts/test-sync.cjs",
    "test:fill": "node scripts/test-fill.cjs",
    "test:migrate": "node scripts/test-migrate.cjs",
    "test:app": "vite build && electron scripts/smoke-electron.cjs",
    "icon": "node scripts/make-icon.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "framer-motion": "^11.11.17",
    "fuse.js": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.nane.atheneum",
    "productName": "Atheneum",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": ["nsis"], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": ["dmg"], "icon": "build/icon.png", "category": "public.app-category.lifestyle" }
  }
}
